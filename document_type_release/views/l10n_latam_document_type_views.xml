<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    ============================================================================
    Document Type Release - Views and Actions
    ============================================================================
    
    This file contains:
    - Server actions for bulk document type management
    - Tree view showing all documents (active and inactive)
    - Search view with filters and grouping options
    - Window action and menu item
    ============================================================================
    -->

    <!-- Server Action: Activate Documents -->
    <record id="action_activate_document_types" model="ir.actions.server">
        <field name="name">Activate Documents</field>
        <field name="model_id" ref="l10n_latam_invoice_document.model_l10n_latam_document_type"/>
        <field name="binding_model_id" ref="l10n_latam_invoice_document.model_l10n_latam_document_type"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.action_activate()
        </field>
    </record>

    <!-- Server Action: Deactivate Documents -->
    <record id="action_deactivate_document_types" model="ir.actions.server">
        <field name="name">Deactivate Documents</field>
        <field name="model_id" ref="l10n_latam_invoice_document.model_l10n_latam_document_type"/>
        <field name="binding_model_id" ref="l10n_latam_invoice_document.model_l10n_latam_document_type"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.action_deactivate()
        </field>
    </record>

    <!-- Server Action: Toggle Active State -->
    <record id="action_toggle_document_types" model="ir.actions.server">
        <field name="name">Toggle Active State</field>
        <field name="model_id" ref="l10n_latam_invoice_document.model_l10n_latam_document_type"/>
        <field name="binding_model_id" ref="l10n_latam_invoice_document.model_l10n_latam_document_type"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.action_toggle_active()
        </field>
    </record>

    <!-- Server Action: Force Availability -->
    <record id="action_force_available_document_types" model="ir.actions.server">
        <field name="name">Force Availability</field>
        <field name="model_id" ref="l10n_latam_invoice_document.model_l10n_latam_document_type"/>
        <field name="binding_model_id" ref="l10n_latam_invoice_document.model_l10n_latam_document_type"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.action_force_available()
        </field>
    </record>

    <!-- Server Action: Remove Forced Availability -->
    <record id="action_remove_force_available_document_types" model="ir.actions.server">
        <field name="name">Remove Forced Availability</field>
        <field name="model_id" ref="l10n_latam_invoice_document.model_l10n_latam_document_type"/>
        <field name="binding_model_id" ref="l10n_latam_invoice_document.model_l10n_latam_document_type"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.action_remove_force_available()
        </field>
    </record>

    <!-- Form View: Inherit standard form to add force_available field -->
    <record id="view_l10n_latam_document_type_form_inherit" model="ir.ui.view">
        <field name="name">l10n_latam.document.type.form.inherit</field>
        <field name="model">l10n_latam.document.type</field>
        <field name="inherit_id" ref="l10n_latam_invoice_document.view_l10n_latam_document_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="force_available"/>
            </xpath>
        </field>
    </record>

    <!-- Tree View: Display all document types with toggle controls -->
    <record id="view_l10n_latam_document_type_tree_all" model="ir.ui.view">
        <field name="name">l10n_latam.document.type.tree.all</field>
        <field name="model">l10n_latam.document.type</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Document Types" multi_edit="1">
                <field name="code"/>
                <field name="name"/>
                <field name="doc_code_prefix"/>
                <field name="report_name" optional="show"/>
                <field name="internal_type" optional="show"/>
                <field name="country_id" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="force_available" widget="boolean_toggle" string="Force"/>
            </list>
        </field>
    </record>

    <!-- Search View: Filters and grouping options -->
    <record id="view_l10n_latam_document_type_search" model="ir.ui.view">
        <field name="name">l10n_latam.document.type.search.release</field>
        <field name="model">l10n_latam.document.type</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <search string="Search Document Types">
                <field name="name"/>
                <field name="code"/>
                <field name="doc_code_prefix"/>
                <field name="country_id"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="filter_inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Forced Availability" name="filter_forced" domain="[('force_available', '=', True)]"/>
                <separator/>
                <filter string="All" name="filter_all" domain="['|', ('active', '=', True), ('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
                    <filter string="Internal Type" name="group_internal_type" context="{'group_by': 'internal_type'}"/>
                    <filter string="Status" name="group_active" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action: Access all document types -->
    <record id="action_l10n_latam_document_type_all" model="ir.actions.act_window">
        <field name="name">Release Document Types</field>
        <field name="res_model">l10n_latam.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('active', '=', True), ('active', '=', False)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="search_view_id" ref="view_l10n_latam_document_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage Document Types
            </p>
            <p>
                Here you can activate or deactivate document types.
                Use "Force Availability" to make a document available
                regardless of AFIP letter or responsibility restrictions.
            </p>
        </field>
    </record>

    <!-- Menu Item: Accounting > Configuration -->
    <menuitem id="menu_document_type_release"
        name="Release Document Types"
        parent="account.account_account_menu"
        action="action_l10n_latam_document_type_all"
        sequence="100"/>

</odoo>
